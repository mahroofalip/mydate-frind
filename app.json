{
  "expo": {
    "name": "kizzora",
    "slug": "kizzora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/kizzora_icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mahroof.friendshipapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "545df850-a213-46f0-a35e-09ff9ad0fded"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/kizzora_icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "owner": "mahroof"
  }
}
